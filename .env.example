# ============================================================
# SENTIVIZE ENVIRONMENT CONFIGURATION
# ============================================================
# Copy file ini menjadi .env dan isi dengan API key Anda
# File .env sudah di-gitignore jadi aman dari commit

# OpenRouter API Key (REQUIRED untuk AI reasoning)
# ============================================================
# Dapatkan API key gratis di: https://openrouter.ai/keys
# Model yang digunakan: deepseek/deepseek-chat (FREE)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative AI Services (OPTIONAL)
# ============================================================
# GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=your_openai_key_here

# Application Settings (OPTIONAL)
# ============================================================
# DEBUG_MODE=false
# MAX_UPLOAD_SIZE_MB=50
# CACHE_DIR=./cache

# AI Engine Mode (OPTIONAL)
# ============================================================
# Set to 'true' if you have low memory (RAM < 8GB)
# Lite mode will use minimal AI models and fallback to simpler algorithms
# AI_LITE_MODE=false

# If you get "paging file too small" error:
# 1. Set AI_LITE_MODE=true
# 2. Or increase Windows virtual memory:
#    - System Properties > Advanced > Performance Settings > Advanced > Virtual Memory > Change
#    - Set custom size: Initial = 4096 MB, Maximum = 8192 MB
